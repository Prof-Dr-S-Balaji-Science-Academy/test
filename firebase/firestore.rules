rules_version = '2';

// Rules v10 (Phase 10, later change): practice mode is no longer saved. Practice
// attempts and practiceStats can no longer be written by students (the
// practiceStats collection has no rule at all now). Mock tests keep only the
// latest attempt of each paper: a new document testResults/{uid}_{paperId}
// points at the student's latest submitted session and carries its attempt
// number; when a new attempt is submitted the student's browser deletes the
// older session of that paper, which the rules allow only once the
// testResults pointer names a different session.
// Rules v9 (Phase 10): the boards, classes, subjects and access levels are no
// longer fixed in these rules. They live in one document, catalog/main, that
// ProfAdmin edits (everyone signed in may read it). A student now holds a LIST
// of access levels (users.accessLevels, at most 8) instead of one, and may
// apply for several (users.requestedLevels). Every rule that used to compare
// one level now accepts any of the student's levels.
// Rules v8: users and admins (v2), the question bank collections taxonomy,
// questions and questionKeys (v3), optional ImageKit image fields (v4), the
// optional Grouping label on questions (v5), student practice mode (v6) and,
// new in v7 (Phase 7), papers and mock tests: papers (ProfAdmin writes,
// approved students of the paper's levels read published ones), testSessions
// (one per student attempt, start time recorded by the server), testLocks
// (while a test is on, a student cannot read any answer key) and mock-test
// attempts. New in v8 (Phase 8): a mock-test attempt may also carry the ID of
// the paper it came from (it must match the paper of its session), so the
// ProfAdmin analytics can show one paper's results without extra reads. In practice mode an approved student may read the answer key of
// one published question of their own level at a time; from v7 that is
// refused while the student has a test in progress (until the test is
// submitted or its time, plus a short grace period, is over).
// Students still cannot read drafts, other levels' questions or any other
// student's records. Everything not listed here stays closed (default deny).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // ProfAdmin = a document exists at admins/<gmail in lowercase>.
    // That collection is edited only in the Firebase console.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }


    // ───────────── Student access (Phase 6) ─────────────

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // True only for a signed-in student whose record says approved.
    function isApprovedStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'approved';
    }

    // ───────────── The catalog (Phase 10) ─────────────

    function cat() {
      return get(/databases/$(database)/documents/catalog/main).data;
    }

    // A board / class / subject that exists in the catalog.
    function inCatalog(board, cls, subject) {
      return (board + '|' + cls + '|' + subject) in cat().subjects;
    }

    // Which board / class / subject a student level may see.
    function levelSees(level, board, cls, subject) {
      return level in cat().levels
        && cat().levels[level].board == board
        && cat().levels[level].cls == cls
        && cat().levels[level].subject == subject;
    }

    // ───────────── Several levels per student (Phase 10) ─────────────
    // Rules cannot loop, so a student's levels (at most 8) are checked slot by slot.

    function myLevelAt(i, theirs) {
      return myProfile().accessLevels.size() > i && myProfile().accessLevels[i] in theirs;
    }

    // True when at least one of the student's levels is in the given list.
    function anyLevel(theirs) {
      return myLevelAt(0, theirs) || myLevelAt(1, theirs) || myLevelAt(2, theirs) || myLevelAt(3, theirs)
          || myLevelAt(4, theirs) || myLevelAt(5, theirs) || myLevelAt(6, theirs) || myLevelAt(7, theirs);
    }

    function mySeesAt(i, board, cls, subject) {
      return myProfile().accessLevels.size() > i && levelSees(myProfile().accessLevels[i], board, cls, subject);
    }

    // True when at least one of the student's levels covers this board / class / subject.
    function anyLevelSees(board, cls, subject) {
      return mySeesAt(0, board, cls, subject) || mySeesAt(1, board, cls, subject) || mySeesAt(2, board, cls, subject)
          || mySeesAt(3, board, cls, subject) || mySeesAt(4, board, cls, subject) || mySeesAt(5, board, cls, subject)
          || mySeesAt(6, board, cls, subject) || mySeesAt(7, board, cls, subject);
    }

    // A published question that belongs to one of the signed-in student's levels.
    function studentCanUse(q) {
      return q.status == 'published' && anyLevel(q.levels);
    }

    function questionDocFor(id) {
      return get(/databases/$(database)/documents/questions/$(id)).data;
    }

    // ───────────── Mock tests (Phase 7) ─────────────

    // The moment a test session stops accepting changes: start + duration + 60 s grace.
    function sessionEnd(s) {
      return s.startedAt + duration.value(s.durationMin, 'm') + duration.value(60, 's');
    }

    function lockPath(uid) {
      return /databases/$(database)/documents/testLocks/$(uid);
    }

    function sessionPath(id) {
      return /databases/$(database)/documents/testSessions/$(id);
    }

    // True when the signed-in student has no test in progress: no lock, a
    // released lock, or a lock whose session ran past its end plus grace.
    function noTestOn() {
      return !exists(lockPath(request.auth.uid))
        || get(lockPath(request.auth.uid)).data.active == false
        || request.time > sessionEnd(get(sessionPath(get(lockPath(request.auth.uid)).data.sessionId)).data);
    }

    // What a student may ask for: one to eight access levels that are open for sign-up.
    function requestOk(d) {
      return d.requestedLevels is list
        && d.requestedLevels.size() >= 1 && d.requestedLevels.size() <= 8
        && d.requestedLevels.hasOnly(cat().activeLevelIds);
    }

    // What a ProfAdmin may change on a student record: only these fields.
    // requestedLevels is included for the one-time conversion of older records.
    function adminUserUpdateOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'accessLevels', 'requestedLevels', 'rejectionReason', 'approvedAt', 'approvedBy'])
        && d.status in ['pending', 'approved', 'rejected', 'suspended']
        && (!changed.hasAny(['accessLevels'])
            || (d.accessLevels is list && d.accessLevels.size() <= 8 && d.accessLevels.hasOnly(cat().allLevelIds)))
        && (!changed.hasAny(['requestedLevels'])
            || (d.requestedLevels is list && d.requestedLevels.size() <= 8 && d.requestedLevels.hasOnly(cat().allLevelIds)))
        && (d.status != 'approved' || ('accessLevels' in d && d.accessLevels.size() >= 1))
        && (!('rejectionReason' in d) || (d.rejectionReason is string && d.rejectionReason.size() <= 300))
        && (!changed.hasAny(['approvedBy']) || d.approvedBy == myEmail());
    }

    // ───────────── Catalog (Phase 10) ─────────────
    // One document, catalog/main. Anyone signed in may read it (it holds only
    // names and codes); only ProfAdmin may create or change it; it is never deleted.
    function catalogOk(d) {
      return d.keys().hasOnly(['boards', 'classes', 'subjects', 'levels', 'activeLevelIds', 'allLevelIds', 'updatedAt'])
        && d.keys().hasAll(['boards', 'classes', 'subjects', 'levels', 'activeLevelIds', 'allLevelIds', 'updatedAt'])
        && d.boards is map && d.boards.size() <= 50
        && d.classes is map && d.classes.size() <= 300
        && d.subjects is map && d.subjects.size() <= 1000
        && d.levels is map && d.levels.size() <= 1000
        && d.activeLevelIds is list && d.activeLevelIds.size() <= 1000
        && d.allLevelIds is list && d.allLevelIds.size() <= 1000
        && d.updatedAt == request.time;
    }

    match /catalog/{docId} {
      allow get: if signedIn() && docId == 'main';
      allow list: if false;
      allow create, update: if isAdmin() && docId == 'main' && catalogOk(request.resource.data);
      allow delete: if false;
    }

    // A signed-in user may check only their own admin entry. No listing,
    // and nobody can write from the website.
    match /admins/{adminEmail} {
      allow get: if signedIn() && myEmail() == adminEmail;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      // Own record, or any record for a ProfAdmin.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // A student can create only their own record, as pending with no access
      // levels. Students can never update or delete it; only a ProfAdmin can.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'photoURL', 'requestedLevels', 'status', 'accessLevels', 'createdAt'])
        && request.resource.data.keys().hasAll([
             'name', 'email', 'photoURL', 'requestedLevels', 'status', 'accessLevels', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.accessLevels == []
        && request.resource.data.createdAt == request.time
        && requestOk(request.resource.data);

      allow update: if isAdmin() && adminUserUpdateOk();
      allow delete: if isAdmin();
    }

    // ───────────── Question bank (Phase 3, images Phase 4, grouping Phase 5, ProfAdmin only) ─────────────

    function chapterOk(d) {
      return inCatalog(d.board, d.cls, d.subject)
        && d.chapterNumber is int && d.chapterNumber >= 1 && d.chapterNumber <= 99
        && d.chapterName is string && d.chapterName.size() >= 1 && d.chapterName.size() <= 120
        && d.edition is string && d.edition.size() <= 40
        && d.nextSerial is int && d.nextSerial >= 1;
    }

    // Image fields hold an ImageKit address of this academy only, and the
    // address and file ID always come as a pair.
    function imagePairOk(d, urlKey, idKey) {
      return (!(urlKey in d) && !(idKey in d))
        || ((urlKey in d) && (idKey in d)
            && d[urlKey] is string && d[urlKey].size() <= 500
            && d[urlKey].matches('^https://ik\\.imagekit\\.io/profbalaji/.+$')
            && d[idKey] is string && d[idKey].size() >= 8 && d[idKey].size() <= 64);
    }

    function questionOk(d) {
      return inCatalog(d.board, d.cls, d.subject)
        && d.type in ['mcq_single', 'mcq_multi', 'true_false', 'fill_blank', 'numerical', 'assertion_reason',
                      'match', 'case_based', 'very_short', 'short', 'long']
        && d.difficulty in ['Easy', 'Medium', 'Hard']
        && d.marks is number && d.marks > 0 && d.marks <= 100
        && d.status in ['draft', 'published']
        && d.displayId is string && d.displayId.size() <= 40
        && d.chapterId is string && d.chapterId.size() > 0
        && d.serial is int && d.serial >= 1
        && d.levels is list && d.levels.size() >= 1 && d.levels.size() <= 2
        && d.questionLatex is string && d.questionLatex.size() <= 20000
        && (!('assertionLatex' in d) || (d.assertionLatex is string && d.assertionLatex.size() <= 20000))
        && (!('reasonLatex' in d) || (d.reasonLatex is string && d.reasonLatex.size() <= 20000))
        && (!('options' in d) || (d.options is list && d.options.size() <= 6))
        && (!('matchLeft' in d) || (d.matchLeft is list && d.matchLeft.size() <= 8))
        && (!('matchRight' in d) || (d.matchRight is list && d.matchRight.size() <= 8))
        && (!('subQuestions' in d) || (d.subQuestions is list && d.subQuestions.size() <= 6))
        && (!('grouping' in d) || (d.grouping is string && d.grouping.size() >= 1 && d.grouping.size() <= 60))
        && imagePairOk(d, 'imageUrl', 'imageFileId');
    }

    function keyOk(d) {
      return d.keys().hasOnly(['correct', 'acceptedAnswers', 'numericAnswer', 'tolerance', 'matchMap',
                               'modelAnswerLatex', 'explanationLatex', 'subKeys',
                               'explanationImageUrl', 'explanationImageFileId'])
        && (!('correct' in d) || (d.correct is list && d.correct.size() <= 6))
        && (!('acceptedAnswers' in d) || (d.acceptedAnswers is list && d.acceptedAnswers.size() <= 8))
        && (!('numericAnswer' in d) || d.numericAnswer is number)
        && (!('tolerance' in d) || (d.tolerance is number && d.tolerance >= 0))
        && (!('matchMap' in d) || (d.matchMap is list && d.matchMap.size() <= 8))
        && (!('modelAnswerLatex' in d) || (d.modelAnswerLatex is string && d.modelAnswerLatex.size() <= 20000))
        && (!('explanationLatex' in d) || (d.explanationLatex is string && d.explanationLatex.size() <= 20000))
        && (!('subKeys' in d) || (d.subKeys is list && d.subKeys.size() <= 6))
        && imagePairOk(d, 'explanationImageUrl', 'explanationImageFileId');
    }

    // One document per chapter. The internal document ID never changes, so
    // renaming or renumbering a chapter does not orphan its questions.
    match /taxonomy/{chapterId} {
      allow read: if isAdmin()
        || (isApprovedStudent()
            && anyLevelSees(resource.data.board, resource.data.cls, resource.data.subject));
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['board', 'cls', 'subject', 'chapterNumber', 'chapterName',
                                                 'edition', 'nextSerial', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['board', 'cls', 'subject', 'chapterNumber', 'chapterName',
                                                'edition', 'nextSerial', 'createdAt', 'updatedAt'])
        && chapterOk(request.resource.data)
        && request.resource.data.nextSerial == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['chapterNumber', 'chapterName', 'edition', 'nextSerial', 'updatedAt'])
        && chapterOk(request.resource.data)
        && request.resource.data.nextSerial >= resource.data.nextSerial
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // The question as a student will eventually see it (no answers here).
    match /questions/{questionId} {
      allow read: if isAdmin() || (isApprovedStudent() && studentCanUse(resource.data));
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['displayId', 'serial', 'chapterId', 'board', 'cls', 'subject',
             'levels', 'type', 'difficulty', 'marks', 'status', 'questionLatex', 'assertionLatex', 'reasonLatex',
             'options', 'matchLeft', 'matchRight', 'subQuestions', 'imageUrl', 'imageFileId', 'grouping',
             'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['displayId', 'serial', 'chapterId', 'board', 'cls', 'subject',
             'levels', 'type', 'difficulty', 'marks', 'status', 'questionLatex', 'createdBy', 'createdAt', 'updatedAt'])
        && questionOk(request.resource.data)
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Identity fields (ID, chapter, type, levels, creator) can never change.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['difficulty', 'marks', 'status', 'questionLatex', 'assertionLatex', 'reasonLatex',
                       'options', 'matchLeft', 'matchRight', 'subQuestions', 'imageUrl', 'imageFileId', 'grouping', 'updatedAt'])
        && questionOk(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Correct answers, model answers and explanations.
    // Students may read one key at a time (get, never list) and only for a
    // published question of their own level, and not while a test is on (v7).
    match /questionKeys/{questionId} {
      allow get: if isAdmin() || (isApprovedStudent() && studentCanUse(questionDocFor(questionId)) && noTestOn());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && keyOk(request.resource.data);
      allow delete: if isAdmin();
    }

    // ───────────── Attempts (Phase 6; practice is not saved from v10, mock tests only) ─────────────

    function answerOk(a) {
      return a is map
        && a.keys().hasOnly(['sel', 'text', 'subs'])
        && (!('sel' in a) || (a.sel is list && a.sel.size() <= 8))
        && (!('text' in a) || (a.text is string && a.text.size() <= 200))
        && (!('subs' in a) || (a.subs is list && a.subs.size() <= 6));
    }

    function attemptOk(d, aid) {
      let q = questionDocFor(d.questionId);
      return studentCanUse(q)
        && d.uid == request.auth.uid
        && d.chapterId == q.chapterId
        && d.board == q.board && d.cls == q.cls && d.subject == q.subject
        && d.type == q.type && d.difficulty == q.difficulty
        && d.scored is bool && d.isCorrect is bool
        && d.timeSpent is number && d.timeSpent >= 0 && d.timeSpent <= 3600
        && answerOk(d.answer)
        && (!('subResults' in d) || (d.subResults is list && d.subResults.size() <= 6))
        && (!('selfRight' in d) || d.selfRight is bool)
        && d.createdAt == request.time
        && d.mode == 'mock'
        && mockAttemptOk(d, aid);
    }

    // A mock-test attempt: one per answered question of a submitted session
    // of this student, with the answer exactly as saved in the session. The
    // document ID is sessionId_questionId, so none can be written twice.
    function mockAttemptOk(d, aid) {
      let s = get(sessionPath(d.sessionId)).data;
      return d.sessionId is string
        && aid == d.sessionId + '_' + d.questionId
        && s.uid == request.auth.uid
        && s.status == 'submitted'
        && d.questionId in s.questionIds
        && d.scored == true
        && d.timeSpent == 0
        && d.answer == s.answers[d.questionId]
        && (!('paperId' in d) || d.paperId == s.paperId);
    }

    // One document per answered question. A student can create their own
    // and read their own; nobody can edit one. ProfAdmin reads all (Phase 8)
    // and may delete (removing a student also removes their history).
    match /attempts/{attemptId} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isApprovedStudent()
        && request.resource.data.keys().hasOnly(['uid', 'questionId', 'chapterId', 'board', 'cls', 'subject',
             'type', 'difficulty', 'mode', 'answer', 'scored', 'isCorrect', 'subResults', 'selfRight',
             'timeSpent', 'createdAt', 'sessionId', 'paperId'])
        && request.resource.data.keys().hasAll(['uid', 'questionId', 'chapterId', 'board', 'cls', 'subject',
             'type', 'difficulty', 'mode', 'answer', 'scored', 'isCorrect', 'timeSpent', 'createdAt'])
        && attemptOk(request.resource.data, attemptId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ───────────── Papers (Phase 7, ProfAdmin writes) ─────────────

    function paperOk(d) {
      return inCatalog(d.board, d.cls, d.subject)
        && d.mode in ['fixed', 'rule']
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 500
        && d.levels is list && d.levels.size() >= 1 && d.levels.size() <= 2
        && levelSees(d.levels[0], d.board, d.cls, d.subject)
        && (d.levels.size() == 1 || levelSees(d.levels[1], d.board, d.cls, d.subject)
            || !(d.levels[1] in cat().levels))
        && d.durationMin is int && d.durationMin >= 1 && d.durationMin <= 300
        && d.negativeMarking is number && d.negativeMarking >= 0 && d.negativeMarking <= 1
        && d.showKeys is bool
        && d.shuffle is bool
        && (d.mode != 'rule' || d.shuffle == true)
        && d.access in ['public', 'locked']
        && d.status in ['draft', 'published']
        && d.count is int && d.count >= 1 && d.count <= 100
        && ((d.mode == 'fixed'
             && !('rules' in d)
             && d.questionIds is list && d.questionIds.size() == d.count)
            || (d.mode == 'rule'
             && !('questionIds' in d)
             && d.rules is map
             && d.rules.keys().hasOnly(['chapterIds', 'types', 'mix'])
             && d.rules.chapterIds is list && d.rules.chapterIds.size() >= 1 && d.rules.chapterIds.size() <= 30
             && d.rules.types is list && d.rules.types.size() >= 1 && d.rules.types.size() <= 11
             && d.rules.mix is map
             && d.rules.mix.keys().hasOnly(['Easy', 'Medium', 'Hard'])
             && d.rules.mix.Easy is int && d.rules.mix.Easy >= 0
             && d.rules.mix.Medium is int && d.rules.mix.Medium >= 0
             && d.rules.mix.Hard is int && d.rules.mix.Hard >= 0
             && d.count == d.rules.mix.Easy + d.rules.mix.Medium + d.rules.mix.Hard));
    }

    // Students read only published papers that list their own access level.
    match /papers/{paperId} {
      allow read: if isAdmin()
        || (isApprovedStudent()
            && resource.data.status == 'published'
            && anyLevel(resource.data.levels));
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['board', 'cls', 'subject', 'mode', 'title', 'description', 'levels',
             'durationMin', 'negativeMarking', 'showKeys', 'shuffle', 'access', 'status', 'count',
             'questionIds', 'rules', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['board', 'cls', 'subject', 'mode', 'title', 'description', 'levels',
             'durationMin', 'negativeMarking', 'showKeys', 'shuffle', 'access', 'status', 'count',
             'createdBy', 'createdAt', 'updatedAt'])
        && paperOk(request.resource.data)
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Board, class, subject, mode and creator never change.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'levels', 'durationMin', 'negativeMarking', 'showKeys', 'shuffle',
                       'access', 'status', 'count', 'questionIds', 'rules', 'updatedAt'])
        && paperOk(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // ───────────── Test sessions and locks (Phase 7) ─────────────

    function sessionStartOk(d, sid) {
      let p = get(/databases/$(database)/documents/papers/$(d.paperId)).data;
      return d.uid == request.auth.uid
        && p.status == 'published'
        && p.access == 'public'
        && d.level in myProfile().accessLevels
        && d.level in p.levels
        && d.board == p.board && d.cls == p.cls && d.subject == p.subject
        && d.paperTitle == p.title
        && d.durationMin == p.durationMin
        && d.negativeMarking == p.negativeMarking
        && d.startedAt == request.time
        && d.status == 'in_progress'
        && d.answers == {}
        && d.marked == []
        && d.questionIds is list && d.questionIds.size() == p.count
        && (p.mode != 'fixed' || d.questionIds.toSet() == p.questionIds.toSet())
        && d.optionOrder is map && d.optionOrder.size() <= 100
        && noTestOn()
        && getAfter(lockPath(request.auth.uid)).data.sessionId == sid;
    }

    // Saving answers while the test runs (and during the grace period).
    function sessionSaveOk() {
      let d = request.resource.data;
      let ch = d.diff(resource.data).affectedKeys();
      return ch.hasOnly(['answers', 'marked', 'savedAt'])
        && d.savedAt == request.time
        && d.answers is map && d.answers.size() <= 100
        && d.marked is list && d.marked.size() <= 100
        && request.time <= sessionEnd(resource.data);
    }

    // Submitting. The server decides "late". A late submission is accepted,
    // but the answers saved last stay as they are.
    function sessionSubmitOk() {
      let d = request.resource.data;
      let ch = d.diff(resource.data).affectedKeys();
      return ch.hasOnly(['status', 'submittedAt', 'late', 'answers', 'marked'])
        && ch.hasAll(['status', 'submittedAt', 'late'])
        && d.status == 'submitted'
        && d.submittedAt == request.time
        && d.late is bool
        && d.late == (request.time > sessionEnd(resource.data))
        && (!d.late || !ch.hasAny(['answers', 'marked']))
        && d.answers is map && d.answers.size() <= 100
        && d.marked is list && d.marked.size() <= 100;
    }

    match /testSessions/{sessionId} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isApprovedStudent()
        && request.resource.data.keys().hasOnly(['uid', 'paperId', 'paperTitle', 'board', 'cls', 'subject', 'level',
             'questionIds', 'optionOrder', 'durationMin', 'negativeMarking', 'startedAt', 'status', 'answers', 'marked'])
        && request.resource.data.keys().hasAll(['uid', 'paperId', 'paperTitle', 'board', 'cls', 'subject', 'level',
             'questionIds', 'optionOrder', 'durationMin', 'negativeMarking', 'startedAt', 'status', 'answers', 'marked'])
        && sessionStartOk(request.resource.data, sessionId);
      allow update: if isApprovedStudent()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'in_progress'
        && (sessionSaveOk() || sessionSubmitOk());
      // ProfAdmin may delete any session. A student may delete only their own
      // submitted session that a newer attempt has replaced: the testResults
      // pointer (in the same batch) must name a different session.
      allow delete: if isAdmin()
        || (isApprovedStudent()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'submitted'
            && exists(resultPath(resource.data.uid + '_' + resource.data.paperId))
            && getAfter(resultPath(resource.data.uid + '_' + resource.data.paperId)).data.sessionId != sessionId);
    }

    // ───────────── Latest mock result per paper (v10) ─────────────
    // One document per student per paper: testResults/{uid}_{paperId}. It names
    // the latest submitted session and its attempt number. Submitting a new
    // attempt overwrites it with the next number (always previous + 1).
    function resultPath(rid) {
      return /databases/$(database)/documents/testResults/$(rid);
    }

    function resultOk(d, rid) {
      let s = getAfter(sessionPath(d.sessionId)).data;
      return d.uid == request.auth.uid
        && rid == d.uid + '_' + d.paperId
        && d.sessionId is string
        && s.uid == request.auth.uid
        && s.paperId == d.paperId
        && s.status == 'submitted'
        && d.paperTitle == s.paperTitle
        && d.late == s.late
        && d.attemptNo is int && d.attemptNo >= 1 && d.attemptNo <= 10000
        && d.submittedAt == request.time;
    }

    match /testResults/{rid} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isApprovedStudent()
        && request.resource.data.keys().hasOnly(['uid', 'paperId', 'paperTitle', 'sessionId', 'attemptNo', 'late', 'submittedAt'])
        && request.resource.data.keys().hasAll(['uid', 'paperId', 'paperTitle', 'sessionId', 'attemptNo', 'late', 'submittedAt'])
        && resultOk(request.resource.data, rid);
      allow update: if isApprovedStudent()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'paperId', 'paperTitle', 'sessionId', 'attemptNo', 'late', 'submittedAt'])
        && request.resource.data.attemptNo == resource.data.attemptNo + 1
        && request.resource.data.sessionId != resource.data.sessionId
        && resultOk(request.resource.data, rid);
      allow delete: if isAdmin();
    }

    // One lock per student. It is created with a new session, released when
    // that session is submitted, and replaced only when no test is on.
    match /testLocks/{lockUid} {
      allow get: if signedIn() && (request.auth.uid == lockUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isApprovedStudent()
        && request.auth.uid == lockUid
        && request.resource.data.keys().hasOnly(['sessionId', 'active', 'updatedAt'])
        && request.resource.data.keys().hasAll(['sessionId', 'active', 'updatedAt'])
        && request.resource.data.active == true
        && request.resource.data.updatedAt == request.time
        && getAfter(sessionPath(request.resource.data.sessionId)).data.uid == request.auth.uid
        && getAfter(sessionPath(request.resource.data.sessionId)).data.status == 'in_progress';
      allow update: if isApprovedStudent()
        && request.auth.uid == lockUid
        && request.resource.data.keys().hasOnly(['sessionId', 'active', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          // a new test starts, and no earlier test is still on
          (request.resource.data.active == true
           && getAfter(sessionPath(request.resource.data.sessionId)).data.uid == request.auth.uid
           && getAfter(sessionPath(request.resource.data.sessionId)).data.status == 'in_progress'
           && (resource.data.active == false
               || request.time > sessionEnd(get(sessionPath(resource.data.sessionId)).data)))
          ||
          // the test is submitted: release the lock
          (request.resource.data.active == false
           && request.resource.data.sessionId == resource.data.sessionId
           && getAfter(sessionPath(resource.data.sessionId)).data.status == 'submitted')
        );
      allow delete: if isAdmin();
    }
  }
}
